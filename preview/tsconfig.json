{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@react-gdoc/primitives": [
        "./primitives"
      ],
      "@react-gdoc/*": [
        "../src/components/*"
      ],
      "@examples/*": [
        "../examples/*"
      ]
    },
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "moduleResolution": "node",
    "target": "ESNext",
    "module": "ESNext",
    "strict": true,
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": [
    "./**/*",
    "../examples/**/*",
    "../src/components/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
